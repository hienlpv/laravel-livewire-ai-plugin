{
  "$schema": "https://raw.githubusercontent.com/gem-team/schema/main/agent-manifest.schema.json",
  "version": "1.0.0",
  "name": "laravel-livewire-plugin",
  "displayName": "Laravel Livewire AI Plugin",
  "description": "Multi-agent Copilot extension for PHP Laravel 11 + Livewire v3 development. Orchestrates backend, frontend, testing, and UI agents.",
  "publisher": "gem-team",
  "homepage": "https://github.com/gem-team/laravel-livewire-ai-plugin",

  "stack": {
    "language": "PHP 8.3",
    "framework": "Laravel 11",
    "frontend": "Livewire v3",
    "css": "Tailwind CSS v3",
    "testing": "Pest PHP",
    "database": "PostgreSQL",
    "standards": ["PSR-12", "Laravel Pint"]
  },

  "orchestrator": {
    "id": "orchestrator",
    "displayName": "Laravel Orchestrator",
    "description": "Entry-point agent. Analyses the user's intent using Chain-of-Thought reasoning, classifies the task as backend / frontend / testing / UI, and delegates to the correct sub-agents in the right sequence.",
    "promptFile": "prompts/orchestrator.md",
    "agentFile": ".github/agents/orchestrator.agent.md",
    "model": "gpt-4o",
    "tools": ["read_file", "create_file", "list_project_files", "run_artisan"],
    "delegates": ["laravel-architect", "livewire-expert", "pest-tester", "tailwind-ui"]
  },

  "agents": [
    {
      "id": "laravel-architect",
      "displayName": "Laravel Architect",
      "description": "Owns all backend concerns: Eloquent Migrations, Models, Service classes, Action classes, DTOs, Repository pattern, and Domain Logic.",
      "promptFile": "prompts/sub-agents/laravel-architect.md",
      "agentFile": ".github/agents/laravel-architect.agent.md",
      "model": "gpt-4o",
      "tools": ["read_file", "create_file", "list_project_files", "run_artisan"],
      "triggers": [
        "migration",
        "model",
        "service",
        "action",
        "dto",
        "repository",
        "domain",
        "backend",
        "eloquent",
        "database",
        "schema",
        "seeder",
        "factory"
      ]
    },
    {
      "id": "livewire-expert",
      "displayName": "Livewire Expert",
      "description": "Owns all Livewire v3 component concerns: Component classes, Blade views, Form Objects, wire:model, #[Validate], lifecycle hooks, computed properties, and Alpine.js entangle.",
      "promptFile": "prompts/sub-agents/livewire-expert.md",
      "agentFile": ".github/agents/livewire-expert.agent.md",
      "model": "gpt-4o",
      "tools": ["read_file", "create_file", "list_project_files", "run_artisan"],
      "triggers": [
        "livewire",
        "component",
        "wire:",
        "entangle",
        "form object",
        "computed",
        "lifecycle",
        "dispatch",
        "event",
        "modal",
        "table",
        "blade"
      ]
    },
    {
      "id": "pest-tester",
      "displayName": "Pest Tester",
      "description": "Owns all test concerns: Pest PHP feature and unit tests for Livewire components, services, actions, and policies. Follows strict TDD and factory-first approach.",
      "promptFile": "prompts/sub-agents/pest-tester.md",
      "agentFile": ".github/agents/pest-tester.agent.md",
      "model": "gpt-4o",
      "tools": ["read_file", "create_file", "list_project_files", "run_artisan"],
      "triggers": ["test", "pest", "phpunit", "tdd", "spec", "assert", "coverage", "feature test", "unit test"]
    },
    {
      "id": "tailwind-ui",
      "displayName": "Tailwind UI",
      "description": "Owns all Tailwind CSS styling within Blade and Livewire views: utility-first layouts, responsive design, dark-mode variants, and component composition.",
      "promptFile": "prompts/sub-agents/tailwind-ui.md",
      "agentFile": ".github/agents/tailwind-ui.agent.md",
      "model": "gpt-4o",
      "tools": ["read_file", "create_file", "list_project_files"],
      "triggers": ["tailwind", "css", "style", "ui", "design", "layout", "responsive", "dark mode", "class", "flex", "grid"]
    }
  ],

  "tools": [
    {
      "id": "read_file",
      "definitionFile": "tools/read-laravel-file.json"
    },
    {
      "id": "create_file",
      "definitionFile": "tools/write-laravel-file.json"
    },
    {
      "id": "list_project_files",
      "definitionFile": "tools/list-project-files.json"
    },
    {
      "id": "run_artisan",
      "definitionFile": "tools/run-artisan.json"
    }
  ],

  "workflows": {
    "crud": {
      "description": "Full CRUD resource workflow",
      "steps": [
        { "agent": "laravel-architect", "task": "migration + model + service + policy" },
        { "agent": "livewire-expert", "task": "table component + form component + modal component" },
        { "agent": "tailwind-ui", "task": "style table, form, and modal views" },
        { "agent": "pest-tester", "task": "feature tests for all Livewire components + unit tests for service" }
      ]
    },
    "component": {
      "description": "Standalone Livewire component workflow",
      "steps": [
        { "agent": "livewire-expert", "task": "component class + blade view" },
        { "agent": "tailwind-ui", "task": "style the blade view" },
        { "agent": "pest-tester", "task": "Pest feature test for the component" }
      ]
    },
    "backend-only": {
      "description": "Backend-only domain logic workflow",
      "steps": [
        { "agent": "laravel-architect", "task": "migration + model + service + action + DTO" },
        { "agent": "pest-tester", "task": "unit tests for service and action" }
      ]
    }
  }
}
