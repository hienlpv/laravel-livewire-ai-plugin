{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "create_file",
  "name": "create_file",
  "displayName": "Write Laravel File",
  "description": "Create or overwrite a file in the Laravel project with the given content. Use this to write migrations, models, services, actions, DTOs, Livewire components, Blade views, and test files.",
  "parameters": {
    "type": "object",
    "required": ["path", "content"],
    "properties": {
      "path": {
        "type": "string",
        "description": "Relative path from the Laravel project root where the file should be written. The directory will be created if it does not exist.",
        "examples": [
          "app/Models/Product.php",
          "app/Livewire/ProductTable.php",
          "app/Forms/ProductForm.php",
          "app/Services/ProductService.php",
          "app/Actions/CreateProductAction.php",
          "app/DTOs/ProductData.php",
          "app/Policies/ProductPolicy.php",
          "database/migrations/2024_01_01_000000_create_products_table.php",
          "database/factories/ProductFactory.php",
          "resources/views/livewire/product-table.blade.php",
          "tests/Feature/Livewire/ProductTableTest.php",
          "tests/Unit/Services/ProductServiceTest.php"
        ]
      },
      "content": {
        "type": "string",
        "description": "The full file content to write. Must be valid PHP, Blade, or JSON. PHP files must begin with '<?php\\n\\ndeclare(strict_types=1);\\n'."
      },
      "overwrite": {
        "type": "boolean",
        "description": "Whether to overwrite an existing file. Defaults to false — set to true only when explicitly replacing existing code.",
        "default": false
      }
    }
  },
  "pathConventions": {
    "model": "app/Models/{ModelName}.php",
    "service": "app/Services/{ModelName}Service.php",
    "action": "app/Actions/{ActionName}Action.php",
    "dto": "app/DTOs/{ModelName}Data.php",
    "policy": "app/Policies/{ModelName}Policy.php",
    "livewire_component": "app/Livewire/{ComponentName}.php",
    "livewire_form": "app/Forms/{ModelName}Form.php",
    "blade_view": "resources/views/livewire/{kebab-name}.blade.php",
    "migration": "database/migrations/{timestamp}_create_{snake_plural}_table.php",
    "factory": "database/factories/{ModelName}Factory.php",
    "seeder": "database/seeders/{ModelName}Seeder.php",
    "feature_test": "tests/Feature/Livewire/{ComponentName}Test.php",
    "unit_test": "tests/Unit/Services/{ModelName}ServiceTest.php"
  }
}
