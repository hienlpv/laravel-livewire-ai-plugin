{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "title": "Tool Definitions — Laravel Livewire AI Plugin",
  "description": "Master definitions file. References all tool definitions used by agents in this plugin.",

  "tools": [
    {
      "id": "read_file",
      "file": "tools/read-laravel-file.json",
      "description": "Read any file in the Laravel project",
      "allowedAgents": ["orchestrator", "laravel-architect", "livewire-expert", "pest-tester", "tailwind-ui"]
    },
    {
      "id": "create_file",
      "file": "tools/write-laravel-file.json",
      "description": "Write or overwrite a file in the Laravel project",
      "allowedAgents": ["laravel-architect", "livewire-expert", "pest-tester", "tailwind-ui"]
    },
    {
      "id": "list_project_files",
      "file": "tools/list-project-files.json",
      "description": "List project files by glob pattern",
      "allowedAgents": ["orchestrator", "laravel-architect", "livewire-expert", "pest-tester", "tailwind-ui"]
    },
    {
      "id": "run_artisan",
      "file": "tools/run-artisan.json",
      "description": "Execute php artisan commands",
      "allowedAgents": ["orchestrator", "laravel-architect", "livewire-expert", "pest-tester"]
    }
  ],

  "fileConventions": {
    "php_header": "<?php\n\ndeclare(strict_types=1);\n\nnamespace {Namespace};\n",
    "blade_root": "Single <div> root element required for all Livewire views",
    "test_header": "<?php\n\ndeclare(strict_types=1);\n\nuse Illuminate\\Foundation\\Testing\\RefreshDatabase;\n"
  }
}
