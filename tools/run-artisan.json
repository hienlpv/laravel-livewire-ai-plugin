{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "run_artisan",
  "name": "run_artisan",
  "displayName": "Run Artisan Command",
  "description": "Execute a Laravel Artisan command and capture its output. Use this to generate stubs, run migrations, clear caches, or check the application state.",
  "parameters": {
    "type": "object",
    "required": ["command"],
    "properties": {
      "command": {
        "type": "string",
        "description": "The artisan command to run, without the 'php artisan' prefix.",
        "examples": [
          "make:model Product -mfs",
          "make:migration create_products_table",
          "make:livewire ProductTable",
          "make:policy ProductPolicy --model=Product",
          "migrate --step",
          "migrate:status",
          "route:list --name=product",
          "tinker --execute=\"Product::count()\"",
          "test --filter=ProductTable"
        ]
      },
      "captureOutput": {
        "type": "boolean",
        "description": "Whether to return the command output. Defaults to true.",
        "default": true
      }
    }
  },
  "allowedCommands": [
    "make:*",
    "migrate",
    "migrate:status",
    "migrate:rollback",
    "db:seed",
    "route:list",
    "route:clear",
    "config:clear",
    "cache:clear",
    "view:clear",
    "optimize:clear",
    "test",
    "tinker"
  ],
  "blockedCommands": ["migrate:fresh", "migrate:reset", "db:wipe", "storage:link"],
  "note": "Blocked commands require explicit user confirmation as they are destructive operations."
}
